    {
      "id": 15,
      "type": "timeseries",
      "title": "Чем занята база: DB Load по классам ожиданий (AAS) vs ядра",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
