{
  "uid": "pg-overview",
  "title": "PostgreSQL: Обзор",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Детальный: по слоям",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pg-layered",
      "keepTime": true,
      "asDropdown": false,
      "includeVars": true,
      "targetBlank": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL жив",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "links": [
        {
          "title": "Слой 3: инстанс",
          "url": "/d/pg-layered?viewPanel=301&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "ЭКСПОРТЁР МЁРТВ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_up{job=~\"$db\"}) or on() vector(0)",
          "refId": "A"
        }
      ],
      "description": "При падении БД серия исчезает, а не становится 0 — «or on() vector(0)» даёт красный ноль. Алерт: absent(pg_up{job=\"primary\"})."
    },
