  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Инстанс",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up, job)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "regex": "/^(primary|standby)$/",
        "current": {
          "text": "primary",
          "value": "primary"
        }
      },
      {
        "name": "host",
        "label": "Хост",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up{job=~\"$db\"}, host)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
