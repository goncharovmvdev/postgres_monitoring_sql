{
  "uid": "pg-overview",
  "title": "PostgreSQL: Обзор",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Layers (incident)",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pg-layered",
      "keepTime": true,
      "includeVars": true,
      "asDropdown": false,
      "targetBlank": false,
      "tags": []
    },
    {
      "title": "Queries (forensics)",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pg-queries",
      "keepTime": true,
      "includeVars": true,
      "asDropdown": false,
      "targetBlank": false,
      "tags": []
    },
    {
      "title": "Hygiene & Debt",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pg-hygiene",
      "keepTime": true,
      "includeVars": true,
      "asDropdown": false,
      "targetBlank": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "links": [
        {
          "title": "Instance: up",
          "url": "/d/pg-layered?viewPanel=301&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "ЭКСПОРТЁР МЁРТВ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_up{node=~\"$node\"}) or on() vector(0)",
          "refId": "A"
        }
      ],
      "description": "When the DB is down the pg_up series DISAPPEARS rather than becoming 0 — «or on() vector(0)» renders a red zero; alert on absent(pg_up). Fix: exporter/network/database — collection health is up{job=~\"sql-.*\"} (Monitoring Health)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sync Standbys",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "links": [
        {
          "title": "Replication: sync standbys",
          "url": "/d/pg-layered?viewPanel=603&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no primary",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_sync_standbys and on(node) (pg_in_recovery == 0)",
          "refId": "A"
        }
      ],
      "description": "Cluster-wide: reads whichever node is currently primary, regardless of the node selector. OK: equals the count in synchronous_standby_names. Fix: 0 = COMMITS ARE STUCK — restore standby/network now or drop sync temporarily; «no primary» = no node reports primary role (both in recovery, or exporter down — check pg-monitoring)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WAL Receiver",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "links": [
        {
          "title": "Replication: WAL receiver",
          "url": "/d/pg-layered?viewPanel=604&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no standby",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_standby_wal_receiver_up and on(node) (pg_in_recovery == 1)",
          "refId": "A"
        }
      ],
      "description": "Cluster-wide: reads whichever node is currently standby, regardless of the node selector. OK: 1. Fix: 0 = the stream is broken (network/slot/timeline) — replay lag may falsely read zero meanwhile; «no standby» = no node reports standby role (promoted pair, or exporter down — check pg-monitoring)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disk Space Free (worst)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "links": [
        {
          "title": "OS: disk space",
          "url": "/d/pg-layered?viewPanel=204&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min(100 * node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes)",
          "refId": "A"
        }
      ],
      "description": "Watch: worst volume trend — WAL/temp can eat space in minutes, not days. OK: > 20–25%. Fix: WAL Directory Size (slot? archiver?) → temp spills (Top Queries by Temp) → bloat (pg_repack)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Connections %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "links": [
        {
          "title": "Instance: connections",
          "url": "/d/pg-layered?viewPanel=302&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * pg_client_backends_count{node=~\"$node\"} / scalar(pg_settings_max_connections{node=~\"$node\"})",
          "refId": "A"
        }
      ],
      "description": "Client backends / max_connections. OK: < 80%. Fix: pooler; who took the slots — Connections by Role."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Max XID Age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "links": [
        {
          "title": "Databases: XID age",
          "url": "/d/pg-layered?viewPanel=402&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200000000
              },
              {
                "color": "red",
                "value": 1000000000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_db_xid_age{node=~\"$node\"})",
          "refId": "A"
        }
      ],
      "description": "Watch: growth without a plateau = autovacuum can't freeze fast enough; the only metric able to stop the database entirely. OK: well below 200M. Fix: Xmin Horizon (who holds it), workers/cost limit."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "links": [
        {
          "title": "Instance: transactions",
          "url": "/d/pg-layered?viewPanel=304&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "commit",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "rollback",
          "refId": "B"
        }
      ],
      "description": "Watch: a commit dip while waits grow = queued; rollback growth = errors/deadlocks/retries. Fix: DB Load (AAS) → by wait class."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query Latency (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "links": [
        {
          "title": "Workload: latency",
          "url": "/d/pg-layered?viewPanel=502&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * rate(pg_statements_exec_seconds_total{node=~\"$node\"}[$__rate_interval]) / clamp_min(rate(pg_statements_calls_total{node=~\"$node\"}[$__rate_interval]), 0.001)",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "description": "Watch: the trend; the average hides tails — see Latency Spread. Fix: DB Load (AAS) → class → tops."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replication Lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "links": [
        {
          "title": "Replication: lag",
          "url": "/d/pg-layered?viewPanel=601&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_replication_lag_seconds{stage=\"replay\"}",
          "legendFormat": "{{application_name}}",
          "refId": "A"
        }
      ],
      "description": "Cluster-wide: the series live on the primary, so no node/host filter — otherwise the panel goes blank whenever a standby is selected. Watch: which stage lags. OK: for sync — milliseconds. Fix: write/flush — standby disk; replay — conflicts / single-threaded replay."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Locks & Long Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "links": [
        {
          "title": "Workload: DB Load",
          "url": "/d/pg-layered?viewPanel=515&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_waiting_sessions{node=~\"$node\",wait_event_type=\"Lock\"}) or vector(0)",
          "legendFormat": "lock waiters",
          "refId": "A"
        },
        {
          "expr": "pg_long_running_transactions{node=~\"$node\"}",
          "legendFormat": "транзакции > 10 сек",
          "refId": "B"
        }
      ],
      "description": "Watch: waiting Lock sessions and transactions above the threshold. OK: 0. Fix: Blocking Sessions (Workload)."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WAL Generation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: WAL",
          "url": "/d/pg-layered?viewPanel=316&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_wal{node=~\"$node\",kind=\"bytes\"}[$__rate_interval])",
          "legendFormat": "WAL",
          "refId": "A"
        }
      ],
      "description": "Watch: bytes/s, buffers_full, FPI share right after a checkpoint. Fix: buffers_full growing → raise wal_buffers; high FPI → wal_compression / less frequent checkpoints; culprit — Top Queries by WAL."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deadlocks & Temp Files",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: deadlocks & temp",
          "url": "/d/pg-layered?viewPanel=309&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{node=~\"$node\"}[5m])) * 60",
          "legendFormat": "deadlocks/мин",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_temp{node=~\"$node\",kind=\"files\"}[5m])) * 60",
          "legendFormat": "temp файлов/мин",
          "refId": "B"
        }
      ],
      "description": "Watch: deadlocks/min > 0; temp bytes/s. Fix: deadlock — lock acquisition order in the app; temp — work_mem / the plan (Top Queries by Temp)."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Tables Needing Vacuum",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 11
      },
      "links": [
        {
          "title": "Hygiene: vacuum debt",
          "url": "/d/pg-hygiene?viewPanel=409&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_tables_need_vacuum{node=~\"$node\"})",
          "refId": "A"
        }
      ],
      "description": "Tables past an autovacuum threshold, summed over reasons: dead tuples, accumulated INSERTS (PG13+ insert-triggered vacuum — append-only tables are invisible to the dead-tuple rule) and tables with autovacuum_enabled=false, which nobody vacuums at all. Per-table reloptions override the global settings and are honoured. OK: 0 to a few. Fix: split by reason (pg_tables_need_vacuum{reason=...}) — workers/naptime/cost for dead, insert thresholds for inserts, and a deliberate plan for disabled ones."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Session Errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 18,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: errors",
          "url": "/d/pg-layered?viewPanel=318&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(pg_stat_database_sessions{node=~\"$node\",kind!=\"total\"}[5m])) * 60",
          "legendFormat": "{{kind}}/мин",
          "refId": "A"
        }
      ],
      "description": "Watch: fatal/killed spikes — broken clients, OOM kills, admin terminations. Fix: per-kind rates in Instance: Health → Session Errors; killed — find who kills (OOM? admin?)."
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Checksum Failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 21,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: checksum failures",
          "url": "/d/pg-layered?viewPanel=617&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "checksums enabled"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF — nothing is verified",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "on",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "max(pg_checksum_failures_total{node=~\"$node\"})",
          "legendFormat": "failures (cumulative)",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "min(pg_settings_data_checksums{node=~\"$node\"})",
          "legendFormat": "checksums enabled",
          "refId": "B",
          "instant": true
        }
      ],
      "description": "Cumulative on purpose: a rate would erase the incident from the panel minutes after it happened. OK: 0 failures AND checksums enabled — with data_checksums off the zero means nothing is being verified. Fix: any growth = page corruption; restore the relation from backup/replica and check disk/RAM."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DB Load (AAS) vs Cores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "links": [
        {
          "title": "Workload: DB Load",
          "url": "/d/pg-layered?viewPanel=515&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ядра"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(pg_wait_profile_total{node=~\"$node\"}[$__rate_interval])) / 100",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        },
        {
          "expr": "count(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"})",
          "legendFormat": "ядра",
          "refId": "B"
        }
      ],
      "description": "Watch: total height vs cores and the dominating class; a Lock-class plateau of height N = N sessions queued. OK: AAS < cores. Fix: Lock → Blocking Sessions; IO → Disk Reads/Writes by Backend + tops; CPU → Top Queries by CPU."
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Disk Latency (worst)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "links": [
        {
          "title": "OS: disk latency",
          "url": "/d/pg-layered?viewPanel=206&var-node=${node}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(1000 * rate(node_disk_read_time_seconds_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]) / clamp_min(rate(node_disk_reads_completed_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]), 0.001))",
          "legendFormat": "read",
          "refId": "A"
        },
        {
          "expr": "max(1000 * rate(node_disk_write_time_seconds_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]) / clamp_min(rate(node_disk_writes_completed_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]), 0.001))",
          "legendFormat": "write",
          "refId": "B"
        }
      ],
      "description": "Watch: per device, the WAL volume separately. OK: SSD/NVMe single-digit ms, > 10–20 ms is bad. Fix: growth at unchanged IOPS — disk/neighbor/throttling (infrastructure); growth together with IOPS — your load → Disk Writes/Reads by Backend."
    },
