{
  "uid": "pg-overview",
  "title": "PostgreSQL: Обзор",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Детальный: по слоям",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pg-layered",
      "keepTime": true,
      "asDropdown": false,
      "includeVars": true,
      "targetBlank": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "links": [
        {
          "title": "Instance: up",
          "url": "/d/pg-layered?viewPanel=301&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "ЭКСПОРТЁР МЁРТВ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_up{job=~\"$db\"}) or on() vector(0)",
          "refId": "A"
        }
      ],
      "description": "When the DB is down the pg_up series DISAPPEARS rather than becoming 0 — «or on() vector(0)» renders a red zero; alert on absent(pg_up). Fix: exporter/network/database — collection health is up{job=~\"sql-.*\"} (Monitoring Health)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sync Standbys",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "links": [
        {
          "title": "Replication: sync standbys",
          "url": "/d/pg-layered?viewPanel=603&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_sync_standbys{job=\"primary\",host=~\"$host\"} or on() vector(0)",
          "refId": "A"
        }
      ],
      "description": "OK: equals the count in synchronous_standby_names. Fix: 0 = COMMITS ARE STUCK — restore standby/network now or drop sync temporarily."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WAL Receiver",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "links": [
        {
          "title": "Replication: WAL receiver",
          "url": "/d/pg-layered?viewPanel=604&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_standby_wal_receiver_up{host=~\"$host\"} or on() vector(0)",
          "refId": "A"
        }
      ],
      "description": "OK: 1. Fix: 0 = the stream is broken (network/slot/timeline) — replay lag may falsely read zero meanwhile."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disk Space Free (worst)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "links": [
        {
          "title": "OS: disk space",
          "url": "/d/pg-layered?viewPanel=204&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min(100 * node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes)",
          "refId": "A"
        }
      ],
      "description": "Watch: worst volume trend — WAL/temp can eat space in minutes, not days. OK: > 20–25%. Fix: WAL Directory Size (slot? archiver?) → temp spills (Top Queries by Temp) → bloat (pg_repack)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Connections %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "links": [
        {
          "title": "Instance: connections",
          "url": "/d/pg-layered?viewPanel=302&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * pg_client_backends_count{job=~\"$db\"} / scalar(pg_settings_max_connections{job=~\"$db\"})",
          "refId": "A"
        }
      ],
      "description": "Client backends / max_connections. OK: < 80%. Fix: pooler; who took the slots — Connections by Role."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Max XID Age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "links": [
        {
          "title": "Databases: XID age",
          "url": "/d/pg-layered?viewPanel=402&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200000000
              },
              {
                "color": "red",
                "value": 1000000000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(pg_db_xid_age{job=~\"$db\"})",
          "refId": "A"
        }
      ],
      "description": "Watch: growth without a plateau = autovacuum can't freeze fast enough; the only metric able to stop the database entirely. OK: well below 200M. Fix: Xmin Horizon (who holds it), workers/cost limit."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "links": [
        {
          "title": "Instance: transactions",
          "url": "/d/pg-layered?viewPanel=304&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{job=~\"$db\"}[1m]))",
          "legendFormat": "commit",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=~\"$db\"}[1m]))",
          "legendFormat": "rollback",
          "refId": "B"
        }
      ],
      "description": "Watch: a commit dip while waits grow = queued; rollback growth = errors/deadlocks/retries. Fix: DB Load (AAS) → by wait class."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query Latency (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "links": [
        {
          "title": "Workload: latency",
          "url": "/d/pg-layered?viewPanel=502&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * rate(pg_statements_exec_seconds_total{job=~\"$db\"}[1m]) / clamp_min(rate(pg_statements_calls_total{job=~\"$db\"}[1m]), 0.001)",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "description": "Watch: the trend; the average hides tails — see Latency Spread. Fix: DB Load (AAS) → class → tops."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replication Lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "links": [
        {
          "title": "Replication: lag",
          "url": "/d/pg-layered?viewPanel=601&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_replication_lag_seconds{host=~\"$host\",stage=\"replay\"}",
          "legendFormat": "{{application_name}}",
          "refId": "A"
        }
      ],
      "description": "Watch: which stage lags. OK: for sync — milliseconds. Fix: write/flush — standby disk; replay — conflicts / single-threaded replay."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Locks & Long Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "links": [
        {
          "title": "Workload: DB Load",
          "url": "/d/pg-layered?viewPanel=515&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_waiting_sessions{job=~\"$db\",wait_event_type=\"Lock\"}) or vector(0)",
          "legendFormat": "lock waiters",
          "refId": "A"
        },
        {
          "expr": "pg_long_running_transactions{job=~\"$db\"}",
          "legendFormat": "транзакции > 5 мин",
          "refId": "B"
        }
      ],
      "description": "Watch: waiting Lock sessions and transactions above the threshold. OK: 0. Fix: Blocking Sessions (Workload)."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WAL Generation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: WAL",
          "url": "/d/pg-layered?viewPanel=316&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_wal{job=~\"$db\",kind=\"bytes\"}[1m])",
          "legendFormat": "WAL",
          "refId": "A"
        }
      ],
      "description": "Watch: bytes/s, buffers_full, FPI share right after a checkpoint. Fix: buffers_full growing → raise wal_buffers; high FPI → wal_compression / less frequent checkpoints; culprit — Top Queries by WAL."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deadlocks & Temp Files",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: deadlocks & temp",
          "url": "/d/pg-layered?viewPanel=309&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{job=~\"$db\"}[5m])) * 60",
          "legendFormat": "deadlocks/мин",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_temp{job=~\"$db\",kind=\"files\"}[5m])) * 60",
          "legendFormat": "temp файлов/мин",
          "refId": "B"
        }
      ],
      "description": "Watch: deadlocks/min > 0; temp bytes/s. Fix: deadlock — lock acquisition order in the app; temp — work_mem / the plan (Top Queries by Temp)."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Tables Needing Vacuum",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 11
      },
      "links": [
        {
          "title": "Databases: vacuum",
          "url": "/d/pg-layered?viewPanel=409&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_tables_need_vacuum{job=~\"$db\"}",
          "refId": "A"
        }
      ],
      "description": "OK: 0 to a few. Fix: workers/naptime/cost; growing while vacuum runs — xmin is held (Workload)."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Session Errors & Checksums",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 11
      },
      "links": [
        {
          "title": "Instance: errors",
          "url": "/d/pg-layered?viewPanel=318&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(pg_stat_database_sessions{job=~\"$db\",kind!=\"total\"}[5m])) * 60",
          "legendFormat": "{{kind}}/мин",
          "refId": "A"
        },
        {
          "expr": "rate(pg_checksum_failures_total{job=~\"$db\"}[5m]) * 60",
          "legendFormat": "checksum/мин",
          "refId": "B"
        }
      ],
      "description": "Watch: fatal/killed spikes; checksum > 0 = page corruption. OK: checksum strictly 0. Fix: checksum — disk/memory, restore from backup/replica; killed — find who kills (OOM? admin?)."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DB Load (AAS) vs Cores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "links": [
        {
          "title": "Workload: DB Load",
          "url": "/d/pg-layered?viewPanel=515&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ядра"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(pg_wait_profile_total{job=~\"$db\"}[1m])) / 100",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        },
        {
          "expr": "count(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"})",
          "legendFormat": "ядра",
          "refId": "B"
        }
      ],
      "description": "Watch: total height vs cores and the dominating class; a Lock-class plateau of height N = N sessions queued. OK: AAS < cores. Fix: Lock → Blocking Sessions; IO → Disk Reads/Writes by Backend + tops; CPU → Top Queries by CPU."
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Disk Latency (worst)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "links": [
        {
          "title": "OS: disk latency",
          "url": "/d/pg-layered?viewPanel=206&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(1000 * rate(node_disk_read_time_seconds_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]) / clamp_min(rate(node_disk_reads_completed_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]), 0.001))",
          "legendFormat": "read",
          "refId": "A"
        },
        {
          "expr": "max(1000 * rate(node_disk_write_time_seconds_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]) / clamp_min(rate(node_disk_writes_completed_total{host=~\"$host\",device!~\"loop.*|dm-.*\"}[5m]), 0.001))",
          "legendFormat": "write",
          "refId": "B"
        }
      ],
      "description": "Watch: per device, the WAL volume separately. OK: SSD/NVMe single-digit ms, > 10–20 ms is bad. Fix: growth at unchanged IOPS — disk/neighbor/throttling (infrastructure); growth together with IOPS — your load → Disk Writes/Reads by Backend."
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "links": [
        {
          "title": "Instance: uptime",
          "url": "/d/pg-layered?viewPanel=614&var-db=${db}&var-host=${host}&from=${__from}&to=${__to}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "ЭКСПОРТЁР МЁРТВ",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_postmaster_uptime_seconds{job=~\"$db\"}",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "description": "Watch: a sharp drop = restart/crash-recovery/failover (red — younger than 10 min). Fix: reason in PG logs; cross-check OOM Kills (OS)."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Инстанс",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up, job)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "regex": "/^(primary|standby)$/",
        "current": {
          "text": "primary",
          "value": "primary"
        }
      },
      {
        "name": "host",
        "label": "Хост",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up{job=~\"$db\"}, host)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "demo-host",
          "value": "demo-host"
        }
      }
    ]
  }
}
